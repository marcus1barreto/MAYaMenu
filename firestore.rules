rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────── Helpers ─────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Verifica se o usuário autenticado é SuperAdmin do MAYaMenu
    function isSuperAdmin() {
      return isSignedIn() && ('superadmin' in request.auth.token) && request.auth.token.superadmin == true;
    }

    // -----------------------------------------------------------------
    // Papéis personalizados (custom claims) + vínculo ativo em equipe/
    // -----------------------------------------------------------------
    function isActiveStaffMember(restauranteId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurantes/$(restauranteId)/equipe/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurantes/$(restauranteId)/equipe/$(request.auth.uid)).data.ativo != false;
    }

    function hasRole(restauranteId, role) {
      return isSignedIn() &&
        ('role' in request.auth.token) &&
        request.auth.token.role == role &&
        (
          get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid ||
          (
            ('restauranteId' in request.auth.token) &&
            request.auth.token.restauranteId == restauranteId &&
            isActiveStaffMember(restauranteId)
          )
        );
    }

    function isOwner(restauranteId) {
      return (isSignedIn() && get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid)
        || hasRole(restauranteId, "owner");
    }

    function isGarcom(restauranteId) {
      return hasRole(restauranteId, "garcom");
    }

    function isCozinha(restauranteId) {
      return hasRole(restauranteId, "cozinha");
    }

    // Transições operacionais válidas para Pedidos e Tickets KDS
    // 'entregue' e 'cancelado' são estados finais na regra do cliente/equipe.
    function isValidOperationalTransition(antes, depois) {
      return depois == antes
        || (antes == 'a_fazer' && depois in ['em_preparo', 'pronto', 'cancelado'])
        || (antes == 'em_preparo' && depois in ['pronto', 'cancelado'])
        || (antes == 'pronto' && depois in ['entregue', 'cancelado']);
    }

    // ─────────────────────────── Coleções Raiz de Controle ───────────────────────────

    // Concessões/Licenças (MAYaRAnas SuperAdmin)
    match /concessoes/{licencaId} {
      allow get: if true; // Permite ler 1 licença na rota efêmera /ativar/[codigo]
      allow list: if isSuperAdmin(); // Apenas SuperAdmin lista todas as concessões
      allow create: if isSuperAdmin(); // Apenas SuperAdmin gera novas licenças

      // Atualização direta de concessões restrita exclusivamente ao SuperAdmin
      allow update: if isSuperAdmin();

      // Exclusão: SuperAdmin, ou lojista somente na mesma operação em que o registro correspondente
      // no arquivo morto passa a existir, em seu nome e com o mesmo identificador (queima atômica).
      allow delete: if isSuperAdmin() || (
        isNonAnonymous()
        && resource.data.status in ['disponivel', 'utilizada']
        && existsAfter(/databases/$(database)/documents/arquivo_morto_licencas/$(licencaId))
        && getAfter(/databases/$(database)/documents/arquivo_morto_licencas/$(licencaId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/arquivo_morto_licencas/$(licencaId)).data.id == licencaId
      );
    }

    // Arquivo Morto de Licenças Utilizadas (Armazenamento em JSON de Auditoria)
    match /arquivo_morto_licencas/{licencaId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      // Criação: SuperAdmin, ou lojista somente na mesma transação que consome uma concessão existente,
      // elegível, com mesmo id/codigo/plano e em nome próprio (fecha criação para códigos inexistentes).
      allow create: if isSuperAdmin() || (
        isNonAnonymous()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == licencaId
        && request.resource.data.codigo == licencaId
        && exists(/databases/$(database)/documents/concessoes/$(licencaId))
        && !existsAfter(/databases/$(database)/documents/concessoes/$(licencaId))
        && get(/databases/$(database)/documents/concessoes/$(licencaId)).data.status in ['disponivel', 'utilizada']
        && request.resource.data.dadosLicenca.plano == get(/databases/$(database)/documents/concessoes/$(licencaId)).data.get('plano', 'free')
      );
      allow update, delete: if false; // Arquivo morto é estritamente imutável (WORM - Write Once, Read Many)
    }

    // Slugs (Trava de Unicidade)
    match /slugs/{slug} {
      allow read: if true; // Validação prévia
      allow create: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
      // Trava de slug é imutável pelo cliente após a criação.
      allow update, delete: if isSuperAdmin();
    }

    // ─────────────────────────── Módulo B2B & Patrocinadores ───────────────────────────

    match /patrocinadores/{patrocinadorId} {
      // Leitura pública para exibição de selo da marca parceira nos cardápios
      allow read: if true;
      // Escrita restrita ao SuperAdmin ou ao próprio patrocinador autenticado
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);

      // Subcoleção Catálogo Master da marca
      match /catalogo_master/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);
      }

      // Subcoleção Lotes de Licenças B2B (Geração exclusiva pelo SuperAdmin ou Backend Admin SDK)
      match /lotes_licencas/{loteId} {
        allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);
        allow write: if isSuperAdmin();
      }

      // Subcoleção Métricas de Sell-Out (Gravação consolidada pelo Backend / Admin SDK)
      match /metricas_sellout/{itemId} {
        allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);
        allow write: if isSuperAdmin();
      }
    }

    // Leitura de lote de licença via collectionGroup restrita ao SuperAdmin ou ao próprio patrocinador
    match /{path=**}/lotes_licencas/{loteId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.patrocinadorId == request.auth.uid);
    }

    // ─────────────────────────── Restaurantes e Operação ───────────────────────────

    // Perfil público minimizado. Nenhum dado de titularidade, licença, plano ou operação é publicado aqui.
    match /restaurantes_publicos/{restauranteId} {
      allow read: if true;
      allow create: if isNonAnonymous()
        && request.resource.data.restauranteId == restauranteId
        && getAfter(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'restauranteId', 'slug', 'nome', 'suspenso', 'configuracoes', 'atualizadoEm'
        ])
        && request.resource.data.configuracoes.keys().hasOnly([
          'corPrimaria', 'tema', 'logoUrl', 'capaUrl', 'modoOperacao', 'modoFilaKds', 'taxaServico'
        ]);
      // Atualizações e exclusões do espelho público são feitas exclusivamente pelo Admin SDK.
      allow update, delete: if false;
    }

    match /restaurantes/{restauranteId} {
      // Documento raiz é privado: titular/equipe ativa e SuperAdmin.
      allow get: if isOwner(restauranteId) || isActiveStaffMember(restauranteId) || isSuperAdmin();
      allow list: if isSuperAdmin();

      // Criação somente no fluxo de ativação: consome uma licença e trava o slug atomicamente.
      allow create: if isNonAnonymous()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.slug is string
        && request.resource.data.licenca.id is string
        && existsAfter(/databases/$(database)/documents/slugs/$(request.resource.data.slug))
        && getAfter(/databases/$(database)/documents/slugs/$(request.resource.data.slug)).data.ownerId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/arquivo_morto_licencas/$(request.resource.data.licenca.id))
        && !existsAfter(/databases/$(database)/documents/concessoes/$(request.resource.data.licenca.id))
        && getAfter(/databases/$(database)/documents/arquivo_morto_licencas/$(request.resource.data.licenca.id)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/arquivo_morto_licencas/$(request.resource.data.licenca.id)).data.dadosLicenca.plano == request.resource.data.plano
        && existsAfter(/databases/$(database)/documents/restaurantes_publicos/$(restauranteId));

      // Lojista só altera campos cadastrais não privilegiados. Plano, licença, titularidade,
      // suspensão e limites são governados exclusivamente pelo SuperAdmin/backend.
      allow update: if isSuperAdmin() || (
        isOwner(restauranteId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'configuracoes', 'atualizadoEm'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['configuracoes'])
          || request.resource.data.configuracoes.diff(resource.data.configuracoes).affectedKeys().hasOnly([
            'corPrimaria', 'tema', 'logoUrl', 'capaUrl', 'modoOperacao', 'modoFilaKds', 'taxaServico'
          ])
        )
      );

      // Exclusão física do tenant é operação administrativa, não do cliente.
      allow delete: if isSuperAdmin();

      // Gestão de Equipe (Garçons e Cozinha)
      match /equipe/{membroId} {
        allow read: if isOwner(restauranteId) || isSuperAdmin() || (isSignedIn() && request.auth.uid == membroId);
        allow create, delete: if isOwner(restauranteId) || isSuperAdmin();
        // Permite ao dono/admin gerenciar tudo ou ao próprio colaborador atualizar seu turno de serviço
        allow update: if isOwner(restauranteId) || isSuperAdmin() || (
          isSignedIn() && request.auth.uid == membroId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'statusTurno',
            'turnoIniciadoEm',
            'turnoPausadoEm',
            'turnoEncerradoEm',
            'atualizadoEm'
          ])
        );
      }

      // Cardápio
      match /cardapio/{itemId} {
        allow read: if true;
        allow write: if isOwner(restauranteId) || isSuperAdmin();
      }

      // Fila Operacional da Cozinha (KDS Tickets Isolados)
      match /kds_tickets/{ticketId} {
        // Leitura restrita à equipe operacional do restaurante ou superadmin
        allow read: if isOwner(restauranteId) || isGarcom(restauranteId) || isCozinha(restauranteId) || isSuperAdmin();

        // Criação de tickets no KDS:
        // EXCLUSIVA das Cloud Functions (Admin SDK) via criarPedidoCliente / lancarPedidoGarcom.
        allow create: if false;

        // Equipe ativa só pode avançar o status operacional seguindo o ciclo válido
        allow update: if (isOwner(restauranteId) || isGarcom(restauranteId) || isCozinha(restauranteId) || isSuperAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
          && isValidOperationalTransition(resource.data.status, request.resource.data.status);

        // Exclusão exclusiva do backend (liberarMesaBackend, Admin SDK)
        allow delete: if false;
      }

      // Mesas e Salão: Leitura restrita à equipe operacional ou SuperAdmin (elimina leitura pública desnecessária)
      // Campos de credencial QR (qrCredencialHash, qrVersao, qrCredencial) são protegidos contra escrita direta
      match /mesas/{numeroMesa} {
        allow read: if isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin();
        allow create: if (isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin())
          && !('qrCredencialHash' in request.resource.data)
          && !('qrVersao' in request.resource.data)
          && !('qrCredencial' in request.resource.data);
        allow update: if (isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'qrCredencialHash',
            'qrVersao',
            'qrCredencial'
          ]);
        // Exclusão física de mesas bloqueada no client (usar desativarMesaBackend para desativação lógica segura)
        allow delete: if false;

        // NÓ PAI: Comanda da Sessão do Cliente (agrega o subtotal)
        match /comandas_abertas/{clienteId} {
          // Leitura restrita: apenas o dono, garçom, superadmin ou o titular da sessão
          allow read: if isOwner(restauranteId)
            || isGarcom(restauranteId)
            || isSuperAdmin()
            || (isSignedIn() && request.auth.uid == clienteId);

          // Criação exclusiva via backend (Admin SDK em criarPedidoCliente / lancarPedidoGarcom)
          allow create: if false;

          // Trava mestra: Se está pago, o cliente não toca mais!
          // Campos financeiros (subtotal, total) e identidade (restauranteId, id, clienteId) são imutáveis no client/equipe.
          allow update: if (
            request.resource.data.restauranteId == resource.data.restauranteId
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['restauranteId'])
          ) && (
            (
              (isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin())
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'chamadoGarcom',
                'garcomResponsavel',
                'atualizadoEm'
              ])
            )
            || (
              isSignedIn()
              && request.auth.uid == clienteId
              && resource.data.status != 'pago'
              && request.resource.data.status != 'pago'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'chamadoGarcom',
                'status',
                'metodoPagamento',
                'pixPayload',
                'solicitacaoPagamentoEm',
                'atualizadoEm',
                'slug'
              ])
              && (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['metodoPagamento'])
                || request.resource.data.metodoPagamento in ['balcao', 'cartao', 'dinheiro', 'pix', 'maquininha']
              )
              && (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pixPayload'])
                || (request.resource.data.pixPayload is string && request.resource.data.pixPayload.size() <= 512)
              )
              && (
                request.resource.data.status == resource.data.status
                || (
                  resource.data.status in ['pedindo', 'aguardando_pratos']
                  && request.resource.data.status == 'conta_pedida'
                )
              )
            )
          );

          // Exclusão exclusiva do backend (liberarMesaBackend, Admin SDK): comanda ativa não some por escrita direta
          allow delete: if false;

          // NÓ FILHO: Rodadas do Cliente (Vai para o KDS da Cozinha)
          match /pedidos/{pedidoId} {
            allow read: if isOwner(restauranteId)
              || isGarcom(restauranteId)
              || isCozinha(restauranteId)
              || isSuperAdmin()
              || (isSignedIn() && request.auth.uid == clienteId);

            // Criação exclusiva via backend (Admin SDK em criarPedidoCliente / lancarPedidoGarcom)
            allow create: if false;

            // Apenas a equipe ativa do restaurante pode avançar status operacional válido do pedido
            allow update: if (isOwner(restauranteId) || isGarcom(restauranteId) || isCozinha(restauranteId) || isSuperAdmin())
              && (
                request.resource.data.restauranteId == resource.data.restauranteId
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['restauranteId'])
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
              && isValidOperationalTransition(resource.data.status, request.resource.data.status);

            // Exclusão exclusiva do backend (liberarMesaBackend, Admin SDK)
            allow delete: if false;
          }
        }
      }

      // Histórico de Sessões de Mesas: criado exclusivamente por liberarMesaBackend (Admin SDK)
      match /historico_sessoes_mesas/{historicoId} {
        allow read: if isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin();
        allow write: if false;
      }

      // Métricas Consolidadas Econômicas: gravação exclusiva do backend (liberarMesaBackend)
      match /metricas_consolidadas/{anoMes} {
        allow read: if isOwner(restauranteId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // ──────────────────────────── CollectionGroup Queries (Leitura KDS/Garçom) ────────────────────────────
    // Leitura operacional vinculada rigorosamente ao restaurante correspondente ou ao titular do pedido
    match /{path=**}/comandas_abertas/{clienteId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == clienteId
        || (
          ('role' in request.auth.token)
          && request.auth.token.role in ['owner', 'garcom', 'cozinha']
          && ('restauranteId' in request.auth.token)
          && resource.data.restauranteId == request.auth.token.restauranteId
          && (
            get(/databases/$(database)/documents/restaurantes/$(resource.data.restauranteId)).data.ownerId == request.auth.uid
            || isActiveStaffMember(resource.data.restauranteId)
          )
        )
      );
    }

    match /{path=**}/pedidos/{pedidoId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || (
          ('clienteId' in resource.data)
          && request.auth.uid == resource.data.clienteId
        )
        || (
          ('role' in request.auth.token)
          && request.auth.token.role in ['owner', 'garcom', 'cozinha']
          && ('restauranteId' in request.auth.token)
          && resource.data.restauranteId == request.auth.token.restauranteId
          && (
            get(/databases/$(database)/documents/restaurantes/$(resource.data.restauranteId)).data.ownerId == request.auth.uid
            || isActiveStaffMember(resource.data.restauranteId)
          )
        )
      );
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────── Helpers ─────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Verifica se o usuário autenticado é o dono do restaurante
    function isOwner(restauranteId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid;
    }

    // Transições de status permitidas para o Cliente na Comanda Pai
    function isAllowedClientStatus(antes, depois) {
      return depois == antes
        || (antes in ['pedindo', 'conta_pedida'] && depois == 'aguardando_pratos')  // envia pedido ou nova rodada
        || (antes in ['pedindo', 'aguardando_pratos'] && depois == 'conta_pedida'); // pede a conta
    }

    // ─────────────────────────── Coleções Raiz de Controle ───────────────────────────

    // Concessões/Licenças (MAYaRAnas SuperAdmin)
    match /concessoes/{licencaId} {
      allow get: if true; // Permite ler 1 licença na rota efêmera /ativar/[codigo]
      allow list: if isNonAnonymous(); // Bloqueia curiosos de listar todas as licenças
      allow create: if isNonAnonymous();
      
      // Permite queima atômica pelo Lojista OU gestão de status pelo SuperAdmin
      allow update: if isNonAnonymous() && (
        (resource.data.status == 'disponivel' && request.resource.data.status == 'utilizada' && request.resource.data.ownerId == request.auth.uid)
        || (request.resource.data.status in ['ativa', 'suspensa', 'revogada'])
      );
      allow delete: if false; // Licenças nunca são apagadas (histórico/auditoria)
    }

    // Slugs (Trava de Unicidade)
    match /slugs/{slug} {
      allow read: if true; // Validação prévia
      allow create, update, delete: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
    }

    // ─────────────────────────── Restaurantes e Operação ───────────────────────────

    match /restaurantes/{restauranteId} {
      // Leitura pública do restaurante
      allow read: if true;
      
      // Criação inicial via runTransaction de ativação
      allow create: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Cardápio
      match /cardapio/{itemId} {
        allow read: if true;
        allow write: if isOwner(restauranteId);
      }

      // Mesas e Salão
      match /mesas/{numeroMesa} {
        allow read: if true;
        allow write: if isOwner(restauranteId);

        // NÓ PAI: Comanda da Sessão do Cliente (agrega o subtotal)
        match /comandas_abertas/{clienteId} {
          allow read: if isSignedIn() && (request.auth.uid == clienteId || isOwner(restauranteId));

          allow create: if isSignedIn() && (
            (request.auth.uid == clienteId && request.resource.data.id == clienteId) 
            || isOwner(restauranteId)
          );

          allow update: if isSignedIn() && (
            (request.auth.uid == clienteId 
              && request.resource.data.id == resource.data.id 
              && isAllowedClientStatus(resource.data.status, request.resource.data.status))
            || isOwner(restauranteId)
          );

          allow delete: if isOwner(restauranteId); // Só lojista/garçom fecha a mesa

          // NÓ FILHO: Rodadas do Cliente (Vai para o KDS da Cozinha)
          match /pedidos/{pedidoId} {
            allow read: if isSignedIn() && (request.auth.uid == clienteId || isOwner(restauranteId));

            allow create: if isSignedIn() && (
              (request.auth.uid == clienteId && request.resource.data.status == 'a_fazer')
              || isOwner(restauranteId)
            );

            allow update, delete: if isOwner(restauranteId); // Só cozinha/garçom muda para 'pronto' ou apaga
          }
        }
      }
    }

    // ──────────────────────────── CollectionGroup Queries (Leitura KDS/Garçom) ────────────────────────────
    // IMPORTANTE: Apenas allow read! A escrita segue a árvore hierárquica protegida acima.
    
    match /{path=**}/comandas_abertas/{clienteId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/pedidos/{pedidoId} {
      allow read: if isSignedIn();
    }

  }
}
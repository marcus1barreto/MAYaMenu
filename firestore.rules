rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────── Helpers ─────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Dono = uid do Firebase Auth gravado em restaurantes/{id}.ownerId.
    // Usuários anônimos (clientes) nunca casam com ownerId.
    function isOwner(restauranteId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid;
    }

    // Campos permitidos numa ComandaCliente (sessão pai)
    function comandaKeys() {
      return ['id', 'restauranteId', 'nomeCliente', 'mesa', 'criadoEm', 'atualizadoEm', 'subtotal', 'status'];
    }

    function isValidComanda(d) {
      return d.keys().hasAll(['id', 'nomeCliente', 'criadoEm', 'subtotal', 'status'])
        && d.keys().hasOnly(comandaKeys())
        && d.nomeCliente is string && d.nomeCliente.size() > 0 && d.nomeCliente.size() <= 60
        && d.subtotal is number && d.subtotal >= 0
        && d.criadoEm is timestamp
        && d.status in ['pedindo', 'aguardando_pratos', 'conta_pedida', 'pago'];
    }

    // Campos permitidos num PedidoRodada (subcoleção pedidos)
    function pedidoKeys() {
      return ['id', 'restauranteId', 'clienteId', 'nomeCliente', 'mesa', 'itens', 'subtotal', 'status', 'criadoEm'];
    }

    function isValidPedido(d, clienteId) {
      return d.keys().hasAll(['id', 'clienteId', 'nomeCliente', 'mesa', 'itens', 'subtotal', 'status', 'criadoEm'])
        && d.keys().hasOnly(pedidoKeys())
        && d.clienteId == clienteId
        && d.nomeCliente is string && d.nomeCliente.size() > 0 && d.nomeCliente.size() <= 60
        && d.itens is list && d.itens.size() > 0 && d.itens.size() <= 100
        && d.subtotal is number && d.subtotal >= 0
        && d.status in ['a_fazer', 'pronto', 'entregue']
        && d.criadoEm is timestamp;
    }

    // Transições de status que o CLIENTE pode fazer na própria comanda.
    // 'pago' e qualquer outra transição são exclusivas do lojista.
    function isAllowedClientStatus(antes, depois) {
      return depois == antes
        || (antes == 'pedindo' && depois == 'aguardando_pratos')                    // enviou o pedido
        || (antes in ['pedindo', 'aguardando_pratos'] && depois == 'conta_pedida'); // pediu a conta
    }

    // ─────────────────────────── Restaurantes ───────────────────────────

    match /restaurantes/{restauranteId} {
      // Leitura pública (PWA do cliente / rotas ISR)
      allow read: if true;

      // Onboarding: na criação ainda não existe `resource`, então valida o
      // documento que está chegando (request.resource).
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.slug is string
        && request.resource.data.nome is string;

      // Só o dono altera, e não pode transferir a propriedade.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // ─────────────────────────── Cardápio ───────────────────────────
      match /cardapio/{itemId} {
        allow read: if true; // Clientes podem ver os pratos
        allow write: if isOwner(restauranteId);
      }

      // ──────────────────────────── Mesas ────────────────────────────
      match /mesas/{numeroMesa} {
        allow read: if true;
        allow write: if isOwner(restauranteId);

        // Nó Pai: a sessão/comanda individual do cliente na mesa.
        // clienteId == uid do login anônimo do cliente (Firebase Auth).
        match /comandas_abertas/{clienteId} {

          // Cliente lê a própria comanda; lojista (garçom/KDS/caixa) lê todas.
          allow read: if isSignedIn()
            && (request.auth.uid == clienteId || isOwner(restauranteId));

          // Cliente cria a própria comanda (status 'pedindo' ou 'aguardando_pratos' ao enviar primeira rodada).
          // Lojista também pode criar (contingência: QR Code lido pelo garçom).
          allow create: if isValidComanda(request.resource.data)
            && request.resource.data.id == clienteId
            && (
              (isSignedIn() && request.auth.uid == clienteId
                && request.resource.data.status in ['pedindo', 'aguardando_pratos']
                && request.resource.data.criadoEm == request.time)
              || isOwner(restauranteId)
            );

          // Atualização da Comanda Pai
          allow update: if isValidComanda(request.resource.data)
            && request.resource.data.id == resource.data.id
            && request.resource.data.criadoEm == resource.data.criadoEm
            && (
              (isSignedIn() && request.auth.uid == clienteId
                && resource.data.status in ['pedindo', 'aguardando_pratos']
                && isAllowedClientStatus(resource.data.status, request.resource.data.status))
              || isOwner(restauranteId)
            );

          // Apenas o lojista fecha/exclui a conta.
          allow delete: if isOwner(restauranteId);

          // ───────────────────── Subcoleção: Pedidos / Rodadas ─────────────────────
          // Cada envio de carrinho é uma rodada que vai para o KDS da cozinha.
          match /pedidos/{pedidoId} {
            // Cliente lê seus próprios pedidos; equipe do restaurante lê todos.
            allow read: if isSignedIn()
              && (request.auth.uid == clienteId || isOwner(restauranteId));

            // Cliente cria novo pedido com status inicial 'a_fazer', desde que a comanda pai não esteja fechada.
            // Dono também pode injetar pedidos (ex: via contingência de garçom).
            allow create: if isValidPedido(request.resource.data, clienteId)
              && (
                (isSignedIn() && request.auth.uid == clienteId
                  && request.resource.data.status == 'a_fazer'
                  && request.resource.data.criadoEm == request.time)
                || isOwner(restauranteId)
              );

            // Cozinha / Garçom atualizam o status de preparo ('a_fazer' -> 'pronto' -> 'entregue').
            allow update: if isOwner(restauranteId);

            // Apenas o lojista remove rodadas se necessário.
            allow delete: if isOwner(restauranteId);
          }
        }
      }
    }

    function isNonAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ──────────────────────────── Concessões & Licenças (Burn-After-Reading) ────────────────────────────
    match /concessoes/{licencaId} {
      // Consulta individual para rota efêmera de onboarding (/ativar/[codigo])
      allow get: if true;

      // Listagem geral restrita: exige login não-anônimo (evita scraping público ou por clientes anônimos)
      allow list: if isNonAnonymous();

      // Criação permitida para operadores autenticados não-anônimos (SuperAdmin)
      allow create: if isNonAnonymous();

      // Queima atômica e estrita:
      // Apenas transição de 'disponivel' -> 'utilizada' vinculada ao uid autenticado
      allow update: if isNonAnonymous()
        && resource.data.status == 'disponivel'
        && request.resource.data.status == 'utilizada'
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if false;
    }

    // Qualquer outro caminho é negado por padrão.
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────── Helpers ─────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Verifica se o usuário autenticado é SuperAdmin do MAYaMenu
    function isSuperAdmin() {
      return isSignedIn() && ('superadmin' in request.auth.token) && request.auth.token.superadmin == true;
    }

    // -----------------------------------------------------------------
    // Papéis personalizados (custom claims) – usado nas regras abaixo
    // -----------------------------------------------------------------
    function hasRole(restauranteId, role) {
      return isSignedIn() &&
        ('role' in request.auth.token) &&
        request.auth.token.role == role &&
        (
          (('restauranteId' in request.auth.token) && request.auth.token.restauranteId == restauranteId) ||
          get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid
        );
    }

    function isOwner(restauranteId) {
      return (isSignedIn() && get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ownerId == request.auth.uid)
        || hasRole(restauranteId, "owner");
    }

    function isGarcom(restauranteId) {
      return hasRole(restauranteId, "garcom");
    }

    function isCozinha(restauranteId) {
      return hasRole(restauranteId, "cozinha");
    }

    // Transições de status permitidas para o Cliente na Comanda Pai
    function isAllowedClientStatus(antes, depois) {
      return depois == antes
        || (antes in ['pedindo', 'conta_pedida'] && depois == 'aguardando_pratos')  // envia pedido ou nova rodada
        || (antes in ['pedindo', 'aguardando_pratos'] && depois == 'conta_pedida'); // pede a conta
    }

    // ─────────────────────────── Coleções Raiz de Controle ───────────────────────────

    // Concessões/Licenças (MAYaRAnas SuperAdmin)
    match /concessoes/{licencaId} {
      allow get: if true; // Permite ler 1 licença na rota efêmera /ativar/[codigo]
      allow list: if isSuperAdmin(); // Apenas SuperAdmin lista todas as concessões
      allow create: if isSuperAdmin(); // Apenas SuperAdmin gera novas licenças

      // Permite queima atômica pelo Lojista que está ativando OU gestão de status pelo SuperAdmin
      allow update: if (
        isNonAnonymous()
        && resource.data.status == 'disponivel'
        && request.resource.data.status == 'utilizada'
        && request.resource.data.ownerId == request.auth.uid
      ) || isSuperAdmin();

      // Permite exclusão apenas quando arquivada pelo SuperAdmin ou no momento da queima
      allow delete: if isSuperAdmin() || (
        isNonAnonymous()
        && resource.data.status == 'utilizada'
        && resource.data.ownerId == request.auth.uid
      );
    }

    // Arquivo Morto de Licenças Utilizadas (Armazenamento em JSON de Auditoria)
    match /arquivo_morto_licencas/{licencaId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSuperAdmin() || (isNonAnonymous() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if false; // Arquivo morto é estritamente imutável (WORM - Write Once, Read Many)
    }

    // Slugs (Trava de Unicidade)
    match /slugs/{slug} {
      allow read: if true; // Validação prévia
      allow create, update, delete: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
    }

    // ─────────────────────────── Módulo B2B & Patrocinadores ───────────────────────────

    match /patrocinadores/{patrocinadorId} {
      // Leitura pública para exibição de selo da marca parceira nos cardápios
      allow read: if true;
      // Escrita restrita ao SuperAdmin ou ao próprio patrocinador autenticado
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);

      // Subcoleção Catálogo Master da marca
      match /catalogo_master/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);
      }

      // Subcoleção Lotes de Licenças B2B (Geração exclusiva pelo SuperAdmin ou Backend Admin SDK)
      match /lotes_licencas/{loteId} {
        allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);
        allow write: if isSuperAdmin();
      }

      // Subcoleção Métricas de Sell-Out (Gravação consolidada pelo Backend / Admin SDK)
      match /metricas_sellout/{itemId} {
        allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == patrocinadorId);
        allow write: if isSuperAdmin();
      }
    }

    // Validação de lote de licença apenas por SuperAdmin ou Dono ativando voucher
    match /{path=**}/lotes_licencas/{loteId} {
      allow read: if isSuperAdmin() || isNonAnonymous();
    }

    // ─────────────────────────── Restaurantes e Operação ───────────────────────────

    match /restaurantes/{restauranteId} {
      // Leitura pública do restaurante
      allow read: if true;

      // Criação inicial via runTransaction de ativação
      allow create: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;

      // Permite atualização de dados cadastrais/temas pelo Dono,
      // governança de suspensão/limites livres é do SuperAdmin, mas o Dono pode ativar patrocínio PRO legítimo
      allow update: if (
        isOwner(restauranteId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'suspenso',
          'maxMesas',
          'maxPratos'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plano'])
          || (request.resource.data.plano == 'pro' && request.resource.data.patrocinio.ativo == true)
        )
      ) || isSuperAdmin();

      allow delete: if isOwner(restauranteId) || isSuperAdmin();

      // Gestão de Equipe (Garçons e Cozinha)
      match /equipe/{membroId} {
        allow read: if isOwner(restauranteId) || isSuperAdmin() || (isSignedIn() && request.auth.uid == membroId);
        allow create, delete: if isOwner(restauranteId) || isSuperAdmin();
        // Permite ao dono/admin gerenciar tudo ou ao próprio colaborador atualizar seu turno de serviço
        allow update: if isOwner(restauranteId) || isSuperAdmin() || (
          isSignedIn() && request.auth.uid == membroId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'statusTurno',
            'turnoIniciadoEm',
            'turnoPausadoEm',
            'turnoEncerradoEm',
            'atualizadoEm'
          ])
        );
      }

      // Cardápio
      match /cardapio/{itemId} {
        allow read: if true;
        allow write: if isOwner(restauranteId) || isSuperAdmin();
      }

      // Fila Operacional da Cozinha (KDS Tickets Isolados)
      match /kds_tickets/{ticketId} {
        // Leitura restrita à equipe operacional do restaurante ou superadmin
        allow read: if isOwner(restauranteId) || isGarcom(restauranteId) || isCozinha(restauranteId) || isSuperAdmin();
        // Criação de tickets por cliente autenticado (da sua sessão) ou equipe
        allow create: if (isSignedIn() && request.resource.data.status == 'a_fazer')
          || isGarcom(restauranteId) || isCozinha(restauranteId);
        // Apenas a equipe (dono/tablet operacional) marcha, cancela ou remove tickets
        allow update, delete: if isOwner(restauranteId) || isGarcom(restauranteId) || isCozinha(restauranteId) || isSuperAdmin();
      }

      // Mesas e Salão: Leitura restrita à equipe operacional ou SuperAdmin (elimina leitura pública desnecessária)
      match /mesas/{numeroMesa} {
        allow read, write: if isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin();

        // NÓ PAI: Comanda da Sessão do Cliente (agrega o subtotal)
        match /comandas_abertas/{clienteId} {
          // Leitura restrita: apenas o dono, garçom, superadmin ou o titular da sessão
          allow read: if isOwner(restauranteId)
            || isGarcom(restauranteId)
            || isSuperAdmin()
            || (isSignedIn() && request.auth.uid == clienteId);

          // Criação: somente se NÃO estiver criando já como pago
          allow create: if (isSignedIn() && request.auth.uid == clienteId)
            && request.resource.data.status in ['pedindo', 'aguardando_pratos'];

          // Trava mestra: Se está pago, o cliente não toca mais!
          // Cliente só pode transitar estados operacionais permitidos (nunca para 'pago')
          allow update: if (isSignedIn() && (
            (request.auth.uid == clienteId 
              && resource.data.status != 'pago'
              && request.resource.data.status != 'pago'
              && (
                request.resource.data.status == resource.data.status
                || isAllowedClientStatus(resource.data.status, request.resource.data.status)
              ))
            || isOwner(restauranteId)
            || isGarcom(restauranteId)
          )) || (
            // Permite atualização de chamado do garçom pelo cliente daquela sessão
            isSignedIn()
            && request.auth.uid == clienteId
            && request.resource.data.id == resource.data.id
            && resource.data.status != 'pago'
            && request.resource.data.status != 'pago'
          );

          // Apenas o Garçom/Dono do restaurante pode libertar e encerrar a mesa
          // O cliente NÃO pode apagar a própria dívida ativa
          allow delete: if isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin();

          // NÓ FILHO: Rodadas do Cliente (Vai para o KDS da Cozinha)
          match /pedidos/{pedidoId} {
            allow read: if isOwner(restauranteId)
              || isGarcom(restauranteId)
              || isCozinha(restauranteId)
              || isSuperAdmin()
              || (isSignedIn() && request.auth.uid == clienteId);

            allow create: if isSignedIn() && (
              (
                request.auth.uid == clienteId 
                && request.resource.data.status == 'a_fazer'
                && get(/databases/$(database)/documents/restaurantes/$(restauranteId)/mesas/$(numeroMesa)/comandas_abertas/$(clienteId)).data.status != 'pago'
              )
              || isGarcom(restauranteId)
              || isCozinha(restauranteId)
            );

            // Apenas a equipe do restaurante pode alterar status ou cancelar pedidos
            allow update, delete: if isGarcom(restauranteId) || isCozinha(restauranteId) || isSuperAdmin();
          }
        }
      }

      // Histórico de Sessões de Mesas (WORM - Write Once, Read Many)
      match /historico_sessoes_mesas/{historicoId} {
        // Apenas Garçom, Dono ou SuperAdmin registram o recibo no encerramento da mesa
        allow create: if isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin();
        allow read: if isOwner(restauranteId) || isGarcom(restauranteId) || isSuperAdmin();
        allow update, delete: if false; // Recibos históricos são estritamente imutáveis
      }

      // Métricas Consolidadas Econômicas (Resumo mensal para Free & PRO)
      match /metricas_consolidadas/{anoMes} {
        allow read: if isOwner(restauranteId) || isSuperAdmin();
        allow write: if isOwner(restauranteId) || isSuperAdmin();
      }
    }

    // ──────────────────────────── CollectionGroup Queries (Leitura KDS/Garçom) ────────────────────────────
    // Leitura operacional vinculada rigorosamente ao restaurante correspondente ou ao titular do pedido
    match /{path=**}/comandas_abertas/{clienteId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == clienteId
        || (
          ('role' in request.auth.token)
          && request.auth.token.role in ['owner', 'garcom', 'cozinha']
          && ('restauranteId' in request.auth.token)
          && request.auth.token.restauranteId == resource.data.restauranteId
        )
      );
    }

    match /{path=**}/pedidos/{pedidoId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == clienteId
        || (
          ('role' in request.auth.token)
          && request.auth.token.role in ['owner', 'garcom', 'cozinha']
          && ('restauranteId' in request.auth.token)
          && request.auth.token.restauranteId == resource.data.restauranteId
        )
      );
    }

  }
}

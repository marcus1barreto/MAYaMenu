rules_version = '2';

// Regras do Firebase Storage - MAYaMenu
// Estrutura: /restaurantes/{restauranteId}/cardapio/{fileName}
// Clientes podem ler as fotos publicamente.
// Apenas o dono autenticado da sua própria pasta de restaurante pode criar, atualizar ou deletar fotos.
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurantes/{restauranteId}/cardapio/{fileName} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == restauranteId;
    }

    match /restaurantes/{restauranteId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == restauranteId;
    }
  }
}

rules_version = '2';

// Regras do Firebase Storage - MAYaMenu
// Permite que qualquer pessoa veja as fotos dos pratos/restaurante.
// Apenas usuários autenticados (donos/gerentes) podem subir ou alterar fotos.
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurantes/{restauranteId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

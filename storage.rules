rules_version = '2';

// Fotos públicas do cardápio e da equipe.
// Uploads somente pelo titular do tenant, com limite de tamanho e MIME permitido.
service firebase.storage {
  match /b/{bucket}/o {
    function isRestaurantOwner(restauranteId) {
      return request.auth != null && request.auth.uid == restauranteId;
    }

    match /restaurantes/{restauranteId}/cardapio/{fileName} {
      allow read: if true;
      allow create, update: if isRestaurantOwner(restauranteId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
      allow delete: if isRestaurantOwner(restauranteId);
    }

    match /restaurantes/{restauranteId}/equipe/{fileName} {
      allow read: if true;
      allow create, update: if isRestaurantOwner(restauranteId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isRestaurantOwner(restauranteId);
    }

    // Nenhum outro caminho sob o tenant recebe permissão genérica de escrita.
    match /restaurantes/{restauranteId}/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
